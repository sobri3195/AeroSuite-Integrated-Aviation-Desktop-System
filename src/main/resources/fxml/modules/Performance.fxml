<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.aerosuite.view.modules.PerformanceController"
            fitToWidth="true">
    <VBox spacing="15" styleClass="content-area">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <Label text="Performance Calculator" styleClass="card-title"/>

        <HBox spacing="20">
            <VBox spacing="15" styleClass="card" prefWidth="400">
                <Label text="Input Parameters" styleClass="section-title"/>

                <GridPane hgap="10" vgap="10">
                    <Label text="Aircraft:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <ComboBox fx:id="aircraftCombo" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="200">
                        <items>
                            <javafx.collections.FXCollections fx:factory="observableArrayList">
                                <String fx:value="Cessna 172"/>
                                <String fx:value="Piper PA-28"/>
                                <String fx:value="Diamond DA40"/>
                            </javafx.collections.FXCollections>
                        </items>
                    </ComboBox>

                    <Label text="Weight (lbs):" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="weightField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Temperature (°C):" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextField fx:id="temperatureField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                    <Label text="Pressure Alt (ft):" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <TextField fx:id="pressureAltField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                    <Label text="Runway Length (ft):" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                    <TextField fx:id="runwayLengthField" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                </GridPane>

                <Button text="Calculate" onAction="#calculatePerformance" styleClass="button-success" maxWidth="Infinity"/>
            </VBox>

            <VBox HBox.hgrow="ALWAYS" spacing="15" styleClass="card">
                <Label text="Results" styleClass="section-title"/>

                <GridPane hgap="15" vgap="10">
                    <Label text="Density Altitude:" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="label-bold"/>
                    <Label fx:id="densityAltLabel" text="0 ft" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="Takeoff Distance:" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="label-bold"/>
                    <Label fx:id="takeoffDistLabel" text="0 ft" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Landing Distance:" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="label-bold"/>
                    <Label fx:id="landingDistLabel" text="0 ft" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                    <Label text="Climb Rate:" GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="label-bold"/>
                    <Label fx:id="climbRateLabel" text="0 fpm" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                </GridPane>

                <Separator/>

                <Label text="Notes" styleClass="section-title"/>
                <TextArea fx:id="notesArea" prefRowCount="8" editable="false" wrapText="true"/>
            </VBox>
        </HBox>

    </VBox>
</ScrollPane>
