<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.aerosuite.view.modules.DashboardController"
            fitToWidth="true" fitToHeight="true">
    <VBox spacing="20" styleClass="content-area">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <Label text="Welcome to AeroSuite" styleClass="card-title">
            <font>
                <Font size="28"/>
            </font>
        </Label>

        <Label text="Your aviation management system dashboard" style="-fx-text-fill: #7f8c8d; -fx-font-size: 14px;"/>

        <GridPane hgap="20" vgap="20">
            <columnConstraints>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
            </columnConstraints>

            <VBox styleClass="stat-card" spacing="10" GridPane.columnIndex="0">
                <Label fx:id="totalFlightsLabel" text="0" styleClass="stat-value"/>
                <Label text="Total Flights" styleClass="stat-label"/>
            </VBox>

            <VBox styleClass="stat-card" spacing="10" GridPane.columnIndex="1" 
                  style="-fx-background-color: linear-gradient(to bottom right, #27ae60, #229954);">
                <Label fx:id="totalHoursLabel" text="0.0" styleClass="stat-value"/>
                <Label text="Total Flight Hours" styleClass="stat-label"/>
            </VBox>

            <VBox styleClass="stat-card" spacing="10" GridPane.columnIndex="2"
                  style="-fx-background-color: linear-gradient(to bottom right, #e74c3c, #c0392b);">
                <Label fx:id="totalAircraftLabel" text="0" styleClass="stat-value"/>
                <Label text="Aircraft Fleet" styleClass="stat-label"/>
            </VBox>

            <VBox styleClass="stat-card" spacing="10" GridPane.columnIndex="3"
                  style="-fx-background-color: linear-gradient(to bottom right, #f39c12, #d68910);">
                <Label fx:id="totalPilotsLabel" text="0" styleClass="stat-value"/>
                <Label text="Registered Pilots" styleClass="stat-label"/>
            </VBox>
        </GridPane>

        <HBox spacing="20">
            <VBox HBox.hgrow="ALWAYS" spacing="10" styleClass="card">
                <Label text="Flight Hours by Category" styleClass="section-title"/>
                <BarChart fx:id="hoursChart" legendVisible="false" prefHeight="300">
                    <xAxis>
                        <CategoryAxis side="BOTTOM"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis side="LEFT" label="Hours"/>
                    </yAxis>
                </BarChart>
            </VBox>
        </HBox>

        <HBox spacing="20">
            <VBox HBox.hgrow="ALWAYS" spacing="10" styleClass="card">
                <Label text="Recent Logbook Entries" styleClass="section-title"/>
                <TableView fx:id="recentFlightsTable" prefHeight="250">
                    <columns>
                        <TableColumn fx:id="dateColumn" text="Date" prefWidth="100"/>
                        <TableColumn fx:id="pilotColumn" text="Pilot" prefWidth="150"/>
                        <TableColumn fx:id="aircraftColumn" text="Aircraft" prefWidth="100"/>
                        <TableColumn fx:id="routeColumn" text="Route" prefWidth="150"/>
                        <TableColumn fx:id="totalTimeColumn" text="Total Time" prefWidth="100"/>
                    </columns>
                </TableView>
            </VBox>
        </HBox>

        <HBox spacing="20">
            <VBox spacing="10" styleClass="card" prefWidth="400">
                <Label text="Quick Stats" styleClass="section-title"/>
                <GridPane hgap="10" vgap="8">
                    <Label text="PIC Hours:" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="label-bold"/>
                    <Label fx:id="picHoursLabel" text="0.0" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    
                    <Label text="Dual Hours:" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="label-bold"/>
                    <Label fx:id="dualHoursLabel" text="0.0" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    
                    <Label text="Night Hours:" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="label-bold"/>
                    <Label fx:id="nightHoursLabel" text="0.0" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    
                    <Label text="Cross Country:" GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="label-bold"/>
                    <Label fx:id="xcHoursLabel" text="0.0" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                </GridPane>
            </VBox>

            <VBox HBox.hgrow="ALWAYS" spacing="10" styleClass="card">
                <Label text="System Information" styleClass="section-title"/>
                <Label text="✓ Database connected" style="-fx-text-fill: #27ae60;"/>
                <Label text="✓ All modules loaded" style="-fx-text-fill: #27ae60;"/>
                <Label fx:id="versionLabel" text="Version 1.0.0" style="-fx-text-fill: #7f8c8d;"/>
                <Separator/>
                <Label text="Quick Access" styleClass="label-bold"/>
                <HBox spacing="10">
                    <Button text="New Flight" onAction="#openLogbook"/>
                    <Button text="Flight Plan" onAction="#openFlightPlanning" styleClass="button-success"/>
                </HBox>
            </VBox>
        </HBox>

    </VBox>
</ScrollPane>
